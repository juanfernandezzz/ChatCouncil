<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:cc="ChatCouncil.Interfaz">
    <!-- La app: riel de secciones y pantalla de Ronda (T18). PantallaRonda.cs la conecta; Aplicacion.cs agrega Configuracion.uxml. Arquitectura: docs/FASE6-INTERFAZ.md. -->
    <ui:VisualElement name="raiz" class="raiz pagina-ampliada">

        <!-- Riel de secciones (D2, D3, D48): desde 600 dp; debajo, el botón Menú de la barra abre el cajón. -->
        <ui:VisualElement class="riel region">
            <ui:Button name="ir-ronda" text="Ronda" class="riel-item" />
            <ui:Button name="ir-historial" text="Historial" class="riel-item" />
            <ui:Button name="ir-ajustes" text="Ajustes" class="riel-item" />
            <ui:Button name="ir-ayuda" text="Ayuda" class="riel-item" />
        </ui:VisualElement>

        <ui:VisualElement name="secciones" class="trabajo">
        <!-- Actualización disponible (Actualizador.cs): oculto hasta que el Release tiene una versión mayor. -->
        <ui:VisualElement name="aviso-version" class="aviso">
            <ui:VisualElement class="aviso-cuerpo">
                <ui:Label name="aviso-texto" class="envolver" />
                <ui:VisualElement name="aviso-barra" class="aviso-barra"><ui:VisualElement name="aviso-relleno" class="aviso-relleno" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="aviso-boton" class="boton boton-primario" />
        </ui:VisualElement>
        <ui:VisualElement name="seccion-ronda" class="trabajo">

            <!-- ===== Ancha (D4) ===== -->
            <ui:VisualElement class="solo-ancha trabajo">
                <ui:VisualElement class="guia region">
                    <ui:VisualElement class="etapas">
                        <ui:VisualElement class="etapa"><ui:Label text="1 Pregunta" class="etapa-nombre" /><ui:VisualElement class="etapa-barra" /></ui:VisualElement>
                        <ui:VisualElement class="etapa"><ui:Label text="2 Investigación" class="etapa-nombre" /><ui:VisualElement class="etapa-barra" /></ui:VisualElement>
                        <ui:VisualElement class="etapa"><ui:Label text="3 Operación" class="etapa-nombre" /><ui:VisualElement class="etapa-barra" /></ui:VisualElement>
                        <ui:VisualElement class="etapa"><ui:Label text="4 Integración" class="etapa-nombre" /><ui:VisualElement class="etapa-barra" /></ui:VisualElement>
                        <ui:VisualElement class="etapa"><ui:Label text="5 Verificación" class="etapa-nombre" /><ui:VisualElement class="etapa-barra" /></ui:VisualElement>
                        <ui:VisualElement class="etapa"><ui:Label text="6 Redacción" class="etapa-nombre" /><ui:VisualElement class="etapa-barra" /></ui:VisualElement>
                        <ui:VisualElement class="etapa"><ui:Label text="7 Informe" class="etapa-nombre" /><ui:VisualElement class="etapa-barra" /></ui:VisualElement>
                    </ui:VisualElement>
                    <!-- La pregunta se escribe en la guía, solo en su etapa (D32). -->
                    <ui:TextField name="pregunta-ancha" label="Tu pregunta" multiline="true" class="campo campo-pregunta solo-etapa-pregunta" />
                    <ui:VisualElement class="paso">
                        <ui:Button name="paso-ancha" class="boton boton-primario semibold" />
                        <ui:VisualElement class="paso-texto">
                            <ui:Label name="frase-ancha" class="envolver" />
                            <ui:Label name="contadores-ancha" class="pequeno texto-2" />
                            <ui:Label name="resultado-ancha" class="envolver resultado" />
                        </ui:VisualElement>
                        <ui:Button name="menu-ronda" text="Ronda…" class="boton" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="cuerpo">
                    <ui:ScrollView name="lista" class="lista region" />
                    <ui:VisualElement class="panel">
                        <ui:VisualElement class="cabecera region">
                            <cc:IconoEstado name="icono-cabecera" />
                            <ui:VisualElement class="cabecera-texto">
                                <ui:Label name="cabecera-titulo" class="semibold" />
                                <ui:Label name="cabecera-problema" class="problema pequeno" />
                            </ui:VisualElement>
                            <ui:Button name="accion-panel" class="boton" />
                            <!-- Ampliado por defecto (la página manda); "Reducir" muestra la guía completa: etapas, qué hacer y contadores. -->
                            <ui:Button name="ampliar" text="Reducir" class="boton" />
                            <ui:Button name="menu-panel" text="Más…" class="boton" />
                        </ui:VisualElement>
                        <ui:VisualElement name="pagina-ancha" class="pagina region">
                            <ui:Label text="Página del proveedor (vista nativa)" class="texto-2" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ===== Angosta (D5) ===== -->
            <ui:VisualElement class="solo-angosta trabajo">
                <ui:VisualElement class="barra region">
                    <ui:Button name="menu" text="Menú" class="boton solo-compacta" />
                    <ui:Label name="barra-titulo" class="barra-titulo semibold" />
                    <ui:Button name="menu-angosta" text="Más…" class="boton" />
                </ui:VisualElement>
                <ui:VisualElement class="progreso">
                    <ui:VisualElement class="etapa-barra" />
                    <ui:VisualElement class="etapa-barra" />
                    <ui:VisualElement class="etapa-barra" />
                    <ui:VisualElement class="etapa-barra" />
                    <ui:VisualElement class="etapa-barra" />
                    <ui:VisualElement class="etapa-barra" />
                    <ui:VisualElement class="etapa-barra" />
                </ui:VisualElement>
                <ui:VisualElement name="pagina-angosta" class="pagina region">
                    <ui:Label text="Página del proveedor (vista nativa)" class="texto-2" />
                </ui:VisualElement>
                <ui:VisualElement class="abajo region">
                    <ui:VisualElement class="selector">
                        <ui:Button name="anterior" text="‹" class="boton boton-icono" />
                        <!-- El problema del panel va dentro del selector (H7). -->
                        <ui:VisualElement class="selector-actual">
                            <ui:VisualElement class="selector-fila">
                                <cc:IconoEstado name="icono-selector" />
                                <ui:Label name="selector-texto" class="semibold selector-texto" />
                            </ui:VisualElement>
                            <ui:Label name="selector-problema" class="problema pequeno" />
                        </ui:VisualElement>
                        <ui:Button name="siguiente" text="›" class="boton boton-icono" />
                    </ui:VisualElement>
                    <ui:TextField name="pregunta-angosta" label="Tu pregunta" multiline="true" class="campo campo-pregunta solo-etapa-pregunta" />
                    <ui:Button name="paso-angosta" class="boton boton-primario semibold" />
                    <ui:Label name="resultado-angosta" class="envolver resultado separado" />
                    <!-- La frase de la etapa a la vista al entrar en ella (H1); después se pliega a un toque (H7). -->
                    <ui:VisualElement name="frase-abierta" class="frase-abierta">
                        <ui:Label name="frase-angosta" class="envolver frase-texto" />
                        <ui:Button name="plegar-frase" text="Entendido" class="boton" />
                    </ui:VisualElement>
                    <ui:VisualElement class="fila-resumen">
                        <ui:Label name="contadores-angosta" class="pequeno texto-2 resumen" />
                        <ui:Button name="abrir-frase" text="Qué hago yo" class="boton" />
                        <ui:Button name="ver-todos" text="Ver todos" class="boton" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Rondas anteriores (D12): Aplicacion.cs llena la lista al entrar. -->
        <ui:VisualElement name="seccion-historial" class="trabajo">
            <ui:VisualElement class="barra solo-compacta region">
                <ui:Button text="Menú" class="boton abre-cajon" />
                <ui:Label text="Rondas anteriores" class="barra-titulo semibold" />
            </ui:VisualElement>
            <ui:ScrollView class="formulario region">
                <ui:VisualElement class="hoja">
                    <ui:Label text="Rondas anteriores" class="titulo-seccion titulo-repetido semibold" />
                    <ui:Label text="Las rondas de este aparato, la más nueva primero." class="envolver texto-2 separado" />
                    <ui:VisualElement name="lista-historial" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- Ayuda y Acerca de (D14, D16). -->
        <ui:VisualElement name="seccion-ayuda" class="trabajo">
            <ui:VisualElement class="barra solo-compacta region">
                <ui:Button text="Menú" class="boton abre-cajon" />
                <ui:Label text="Ayuda" class="barra-titulo semibold" />
            </ui:VisualElement>
            <ui:ScrollView class="formulario region">
                <ui:VisualElement class="hoja lectura">
                    <ui:Label text="Ayuda" class="titulo-seccion titulo-repetido semibold" />
                    <ui:VisualElement class="bloque">
                        <ui:Label text="Cómo funciona una ronda" class="titulo-bloque semibold" />
                        <ui:Label class="envolver separado" text="Haces una pregunta a varios proveedores de IA a la vez, cada uno en su página y con tu cuenta. Después cada proveedor revisa a ciegas lo que respondieron los demás y anota en qué coinciden y en qué no. Un integrador junta esos hallazgos en un informe, dos verificadores revisan por separado las fuentes en la web y un redactor escribe la respuesta final." />
                        <ui:Label class="envolver separado" text="La app pega, captura y arma el informe. Enviar en cada página lo haces tú: así eliges qué activar en cada proveedor y nada sale sin que lo revises." />
                    </ui:VisualElement>
                    <ui:VisualElement class="bloque">
                        <ui:Label text="Las siete etapas" class="titulo-bloque semibold" />
                        <ui:Label class="envolver separado" text="1. Pregunta: escribes la pregunta y la app la pega en cada página." />
                        <ui:Label class="envolver separado" text="2. Investigación: en cada página activas la búsqueda web y envías; cuando terminan, la app captura las respuestas." />
                        <ui:Label class="envolver separado" text="3. Operación: la app abre una conversación nueva en cada página y le pega las respuestas de los demás, sin decir de quién son. Tú envías y la app captura lo que cada uno encontró." />
                        <ui:Label class="envolver separado" text="4. Integración: el integrador recibe la tabla de hallazgos y escribe el informe." />
                        <ui:Label class="envolver separado" text="5. Verificación: dos verificadores revisan por separado en la web las fuentes de lo que conviene rescatar; el informe muestra las dos verificaciones para compararlas." />
                        <ui:Label class="envolver separado" text="6. Redacción: el redactor recibe todo el material en un archivo adjunto y escribe la respuesta final." />
                        <ui:Label class="envolver separado" text="7. Informe: la app comprueba las direcciones web que citaron los verificadores y arma una carpeta con el informe en Markdown y PDF y las respuestas de cada proveedor." />
                    </ui:VisualElement>
                    <ui:VisualElement class="bloque">
                        <ui:Label text="Palabras de la app" class="titulo-bloque semibold" />
                        <ui:Label class="envolver separado" text="Proveedores: los servicios de IA de tu consejo (ChatGPT, Gemini y los demás). Los que no tienen un rol investigan y después evalúan las respuestas de los otros." />
                        <ui:Label class="envolver separado" text="Roles: integrador, dos verificadores y redactor. Cada uno trabaja en su etapa; el redactor puede ser el mismo integrador." />
                    </ui:VisualElement>
                    <ui:VisualElement class="bloque">
                        <ui:Label text="Atajos de teclado" class="titulo-bloque semibold" />
                        <ui:Label class="envolver separado" text="F1 y F2: el panel anterior y el siguiente. Ctrl+Mayús+Tab y Ctrl+Tab hacen lo mismo." />
                        <ui:Label class="envolver separado" text="F3: el paso siguiente (el botón principal)." />
                        <ui:Label class="envolver separado" text="F4 y F5: pasar a la parte siguiente o a la anterior de la pantalla: la guía, la lista de paneles, el panel y la página del proveedor." />
                        <ui:Label class="envolver separado" text="Funcionan también con el foco dentro de la página de un proveedor: la tecla vuelve a la app." />
                        <ui:Label class="envolver texto-2 separado" text="Ninguno usa Enter ni Ctrl+Enter, que en las páginas envían." />
                    </ui:VisualElement>
                    <ui:VisualElement class="bloque">
                        <ui:Label text="Acerca de ChatCouncil" class="titulo-bloque semibold" />
                        <ui:Label name="version" class="envolver separado" />
                        <ui:Label class="envolver separado" text="Al abrirse, la app busca una versión nueva y te la ofrece arriba. Las versiones publicadas están en la página del proyecto." />
                        <ui:Button name="ver-versiones" text="Ver las versiones publicadas" class="boton boton-solo" />
                        <ui:Label text="Licencias de terceros" class="subtitulo semibold" />
                        <ui:Label class="envolver separado" text="Atkinson Hyperlegible Next, del Braille Institute: SIL Open Font License 1.1. marked: licencia MIT. Newtonsoft.Json: licencia MIT. Microsoft Edge WebView2: licencia del SDK de Microsoft. AndroidX WebKit: licencia Apache 2.0. Hecha con Unity: términos de Unity." />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        </ui:VisualElement>

        <!-- Cajón modal de la clase compacta (D3): las mismas secciones que el riel. -->
        <ui:VisualElement name="cajon" class="cajon">
            <ui:VisualElement class="cajon-hoja">
                <ui:Button name="cajon-ronda" text="Ronda" class="boton cajon-item" />
                <ui:Button name="cajon-historial" text="Historial" class="boton cajon-item" />
                <ui:Button name="cajon-ajustes" text="Ajustes" class="boton cajon-item" />
                <ui:Button name="cajon-ayuda" text="Ayuda" class="boton cajon-item" />
            </ui:VisualElement>
            <ui:Button name="cajon-fondo" class="cajon-fondo" />
        </ui:VisualElement>

        <!-- Menús y diálogos. Las páginas nativas van encima de todo lo de Unity: se apartan mientras la capa está abierta. -->
        <ui:VisualElement name="capa" class="capa">
            <ui:Button name="capa-fondo" class="capa-fondo" />
            <ui:ScrollView name="menu-flotante" class="menu-flotante" />
            <ui:VisualElement name="dialogo" class="dialogo">
                <ui:Label name="dialogo-titulo" class="titulo-bloque semibold" />
                <ui:ScrollView class="dialogo-cuerpo"><ui:Label name="dialogo-texto" class="envolver separado" /></ui:ScrollView>
                <ui:TextField name="dialogo-campo" multiline="true" class="campo campo-pregunta" />
                <ui:Toggle name="dialogo-casilla" class="marca marca-ancha" />
                <ui:VisualElement class="fila-botones dialogo-botones">
                    <ui:Button name="dialogo-aceptar" class="boton boton-primario semibold" />
                    <ui:Button name="dialogo-cancelar" text="Cancelar" class="boton" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
